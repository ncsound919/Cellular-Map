{
  "nanostealth_module": {
    "version": "1.0.0",
    "description": "NanoStealth nanocarrier delivery optimization platform configuration",
    "status": "active",
    
    "core_engine": {
      "python_version": "3.11+",
      "numerical_stack": {
        "numpy": "^1.24.0",
        "pandas": "^2.0.0",
        "scipy": "^1.11.0",
        "scikit-learn": "^1.3.0"
      },
      "pk_pd_libraries": {
        "pkpy": {
          "enabled": true,
          "description": "Population PK/PD simulations",
          "repository": "https://github.com/pkpy/pkpy"
        },
        "popy": {
          "enabled": true,
          "description": "Population pharmacokinetic modeling",
          "notes": "Alternative to PKPy for specific use cases"
        },
        "pysb_pkpd": {
          "enabled": true,
          "description": "Rule-based mechanistic PK/PD modeling",
          "repository": "https://pysb.org/"
        }
      },
      "compartmental_models": {
        "two_compartment": {
          "enabled": true,
          "description": "Standard two-compartment PK model for most nanocarriers"
        },
        "three_compartment": {
          "enabled": true,
          "description": "Extended model for complex biodistribution"
        },
        "pbpk": {
          "enabled": false,
          "description": "Physiologically-based PK (future enhancement)",
          "status": "planned"
        }
      }
    },
    
    "nanostealth_metrics": {
      "trueness": {
        "description": "Targeting accuracy to tumor sites",
        "formula": "(tumor_accumulation / total_dose) * specificity_factor",
        "range": [0.0, 1.0],
        "optimal": "> 0.65",
        "units": "fraction"
      },
      "flow": {
        "description": "Circulation kinetics and biodistribution",
        "formula": "AUC_plasma / (dose * clearance_rate)",
        "units": "hours",
        "optimal": "12-48 hours half-life"
      },
      "toxicity": {
        "description": "Off-target accumulation and safety",
        "formula": "(liver_accumulation * 0.4) + (spleen_accumulation * 0.3) + (kidney_accumulation * 0.3)",
        "range": [0.0, 1.0],
        "acceptable": "< 0.35",
        "units": "burden_score"
      }
    },
    
    "self_driving_lab": {
      "opentrons": {
        "enabled": true,
        "api_version": "2.15+",
        "supported_robots": ["OT-2", "Flex"],
        "protocol_format": "python",
        "endpoints": {
          "generate_protocol": "/api/v1/nanostealth/protocols/generate",
          "validate_protocol": "/api/v1/nanostealth/protocols/validate",
          "queue_protocol": "/api/v1/nanostealth/protocols/queue"
        },
        "capabilities": [
          "nanoparticle_synthesis",
          "drug_loading",
          "surface_modification",
          "size_characterization_prep",
          "dose_preparation"
        ]
      },
      "ivoryos": {
        "enabled": true,
        "description": "Web orchestrator for autonomous experimentation",
        "integration_mode": "decision_node",
        "endpoints": {
          "workflow_submit": "/api/v1/nanostealth/workflow/submit",
          "optimization_callback": "/api/v1/nanostealth/workflow/optimize"
        },
        "features": [
          "auto_ui_generation",
          "closed_loop_optimization",
          "experiment_tracking"
        ]
      },
      "synthetic_instruction_set": {
        "version": "1.0",
        "supported_operations": [
          "formulate",
          "characterize",
          "test_cellular",
          "test_in_vivo",
          "optimize"
        ],
        "output_format": "json",
        "execution_engine": "opentrons_python_api"
      }
    },
    
    "clinical_integration": {
      "fhir": {
        "version": "R4",
        "enabled": true,
        "server": {
          "type": "medplum",
          "url": "${FHIR_SERVER_URL}",
          "auth": "oauth2"
        },
        "resources": {
          "MedicationAdministration": {
            "enabled": true,
            "description": "Nanocarrier dosing records",
            "custom_extensions": [
              "nanoparticle-formulation",
              "particle-size",
              "surface-chemistry",
              "drug-loading"
            ]
          },
          "Observation": {
            "enabled": true,
            "description": "PK/PD measurements, biomarker data",
            "code_systems": ["LOINC", "SNOMED-CT"],
            "custom_observations": [
              "plasma-concentration",
              "tumor-accumulation",
              "clearance-rate",
              "biodistribution-ratio"
            ]
          },
          "DiagnosticReport": {
            "enabled": true,
            "description": "Toxicity labs, imaging studies"
          },
          "ResearchStudy": {
            "enabled": true,
            "description": "Clinical trial integration"
          }
        },
        "sdk": {
          "name": "open_health_stack_fhir_sdk",
          "repository": "https://github.com/openhealthstack/fhir-sdk"
        }
      },
      "ehr_integration": {
        "smart_on_fhir": {
          "enabled": false,
          "status": "planned",
          "description": "SMART-on-FHIR app launch capability"
        },
        "data_sync": {
          "mode": "pull",
          "schedule": "hourly",
          "resources": ["Patient", "Condition", "Observation", "MedicationAdministration"]
        }
      }
    },
    
    "orchestration": {
      "microservice": {
        "framework": "fastapi",
        "host": "0.0.0.0",
        "port": 8001,
        "workers": 4,
        "reload": false,
        "log_level": "info"
      },
      "api_routes": {
        "prefix": "/api/v1/nanostealth",
        "endpoints": [
          {
            "path": "/optimize",
            "method": "POST",
            "description": "Run nanocarrier optimization"
          },
          {
            "path": "/pk-model",
            "method": "POST",
            "description": "Execute PK/PD simulation"
          },
          {
            "path": "/protocols",
            "method": "GET",
            "description": "List Opentrons protocols"
          },
          {
            "path": "/protocols/generate",
            "method": "POST",
            "description": "Generate Opentrons protocol"
          },
          {
            "path": "/fhir/{resource_type}",
            "method": "GET",
            "description": "FHIR resource endpoints"
          },
          {
            "path": "/metrics",
            "method": "GET",
            "description": "Get Trueness/Flow/Toxicity metrics"
          }
        ]
      },
      "containerization": {
        "docker": {
          "enabled": true,
          "base_image": "python:3.11-slim",
          "expose_ports": [8001],
          "environment_vars": [
            "FHIR_SERVER_URL",
            "OPENTRONS_API_KEY",
            "DATABASE_URL",
            "REDIS_URL"
          ]
        },
        "docker_compose": {
          "services": ["nanostealth-api", "postgres", "redis", "fhir-server"]
        }
      },
      "ci_cd": {
        "platform": "github_actions",
        "workflows": [
          {
            "name": "test",
            "triggers": ["push", "pull_request"],
            "steps": [
              "lint",
              "type_check",
              "unit_tests",
              "integration_tests",
              "pk_model_validation"
            ]
          },
          {
            "name": "security",
            "triggers": ["push", "schedule"],
            "steps": [
              "dependency_check",
              "sast_scan",
              "container_scan"
            ]
          },
          {
            "name": "deploy",
            "triggers": ["push:main"],
            "steps": [
              "build_docker",
              "push_registry",
              "deploy_staging",
              "smoke_tests",
              "deploy_production"
            ]
          }
        ],
        "self_hosted_runners": {
          "enabled": true,
          "description": "Lab Raspberry Pi for local deployment",
          "tags": ["lab", "opentrons"]
        }
      }
    },
    
    "labops_collaboration": {
      "git": {
        "enabled": true,
        "repositories": {
          "protocols": "git@github.com:org/nanostealth-protocols.git",
          "configs": "git@github.com:org/nanostealth-configs.git"
        }
      },
      "nextcloud": {
        "enabled": false,
        "url": "${NEXTCLOUD_URL}",
        "description": "Lab data and result sharing",
        "sync_folders": [
          "nanostealth_results",
          "characterization_data",
          "optimization_runs"
        ]
      },
      "mattermost": {
        "enabled": false,
        "url": "${MATTERMOST_URL}",
        "description": "Team communication and notifications",
        "channels": [
          "nanostealth-alerts",
          "lab-automation",
          "optimization-results"
        ]
      },
      "wiki": {
        "platform": "bookstack",
        "enabled": false,
        "url": "${WIKI_URL}",
        "sections": [
          "protocols",
          "sops",
          "troubleshooting",
          "formulation_database"
        ]
      },
      "jupyter": {
        "enabled": false,
        "platform": "jupyterhub",
        "url": "${JUPYTER_URL}",
        "description": "Collaborative data analysis"
      }
    },
    
    "frontend": {
      "framework": "react_nextjs",
      "typescript": true,
      "components": [
        {
          "name": "OptimizationDashboard",
          "description": "Real-time Trueness/Flow/Toxicity visualization",
          "route": "/nanostealth/dashboard"
        },
        {
          "name": "ProtocolBuilder",
          "description": "Interactive nanocarrier design",
          "route": "/nanostealth/builder"
        },
        {
          "name": "PKPDSimulator",
          "description": "Concentration-time curve explorer",
          "route": "/nanostealth/simulator"
        },
        {
          "name": "WhatIfAnalysis",
          "description": "Compare formulation scenarios",
          "route": "/nanostealth/analysis"
        },
        {
          "name": "LabQueue",
          "description": "Opentrons protocol status",
          "route": "/nanostealth/lab-queue"
        }
      ],
      "visualization": {
        "plotly": {
          "enabled": true,
          "use_cases": ["3D biodistribution", "PK curves", "optimization surfaces"]
        },
        "vega_lite": {
          "enabled": true,
          "use_cases": ["declarative PK curves", "dose-response plots"]
        },
        "d3": {
          "enabled": true,
          "use_cases": ["custom nanoparticle visualizations", "network graphs"]
        }
      },
      "styling": {
        "framework": "tailwindcss",
        "theme": "healthcare",
        "accessibility": "wcag_2.2_aa"
      }
    },
    
    "explainability": {
      "cdss_integration": {
        "enabled": true,
        "pattern": "recommendation_with_rationale",
        "components": [
          "scoring_transparency",
          "evidence_links",
          "confidence_intervals",
          "what_changed_explanation"
        ]
      },
      "output_format": {
        "recommendation": "structured",
        "rationale": "human_readable_text",
        "evidence": "cited_references",
        "confidence": "percentage_with_interval"
      }
    },
    
    "tumortrack_integration": {
      "enabled": true,
      "integration_points": [
        {
          "component": "patients",
          "description": "Link nanocarrier PK to patient records"
        },
        {
          "component": "protocols",
          "description": "Add nanoformulations to treatment protocols"
        },
        {
          "component": "simulations",
          "description": "Combine chemotherapy dynamics with nanodelivery"
        },
        {
          "component": "nba_translation",
          "description": "Map nanocarrier metrics to NBA-style scores"
        }
      ],
      "nba_mapping": {
        "trueness": {
          "nba_metric": "3P%",
          "description": "Three Point Percentage - Accuracy/hit rate"
        },
        "flow": {
          "nba_metric": "AST%",
          "description": "Assist Percentage - Circulation efficiency"
        },
        "toxicity": {
          "nba_metric": "TOV%",
          "description": "Turnover Percentage - Failure/adverse event rate"
        },
        "durability": {
          "nba_metric": "MP",
          "description": "Minutes Played - Treatment sustainability"
        }
      }
    },
    
    "security_compliance": {
      "hipaa": {
        "enabled": true,
        "inherited_from": "tumortrack_platform"
      },
      "data_encryption": {
        "at_rest": "AES-256",
        "in_transit": "TLS 1.3"
      },
      "audit_logging": {
        "enabled": true,
        "events": [
          "optimization_run",
          "protocol_generation",
          "fhir_access",
          "pk_model_execution"
        ]
      },
      "fda_21cfr_part11": {
        "enabled": false,
        "status": "planned",
        "description": "Electronic records and signatures for lab automation"
      }
    },
    
    "extensibility": {
      "custom_pk_models": {
        "enabled": true,
        "base_class": "nanostealth.pk_models.BasePKModel",
        "plugin_directory": "plugins/pk_models"
      },
      "custom_protocols": {
        "enabled": true,
        "base_class": "nanostealth.protocols.ProtocolBuilder",
        "plugin_directory": "plugins/protocols"
      },
      "custom_optimization": {
        "enabled": true,
        "base_class": "nanostealth.optimization.BaseOptimizer",
        "plugin_directory": "plugins/optimizers"
      }
    },
    
    "future_enhancements": {
      "multiscale_modeling": {
        "status": "planned",
        "description": "Link molecular dynamics to tissue-level PK"
      },
      "ai_driven_optimization": {
        "status": "planned",
        "description": "Reinforcement learning for formulation design"
      },
      "realtime_imaging": {
        "status": "planned",
        "description": "In vivo tracking of nanocarriers"
      },
      "regulatory_module": {
        "status": "planned",
        "description": "Automated IND/NDA documentation"
      },
      "manufacturing_scaleup": {
        "status": "planned",
        "description": "Tech transfer from bench to GMP production"
      }
    }
  }
}
