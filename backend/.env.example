# Environment variables for NetworkCellularMap

# Application
APP_NAME=NetworkCellularMap
VERSION=2.0
DEBUG=False

# API
API_V1_PREFIX=/api/v1

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=networkology
NEO4J_DATABASE=neo4j

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# External APIs
OMIM_API_KEY=your_omim_api_key_here
NCBI_API_KEY=your_ncbi_api_key_here
KEGG_API_BASE=https://rest.kegg.jp

# AI Models
MODEL_PATH=./models
CAUSAL_DISCOVERY_METHOD=PC_stable

# Network Analysis
HUB_DEGREE_THRESHOLD=50
HUB_BETWEENNESS_THRESHOLD=0.1
POWER_LAW_ALPHA_MIN=2.1
POWER_LAW_ALPHA_MAX=2.7

# CRISPR Design
GRNA_LENGTH=20
AAV9_CAPACITY_KB=4.7
AAV9_TITER_MIN=1e13
